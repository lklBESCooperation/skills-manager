{
  "name": "@pmstudio/skills-manager",
  "version": "0.1.3",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "orca-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts/skill-install-providers": {
      "types": "./dist/contracts/skill-install-providers.d.ts",
      "default": "./dist/contracts/skill-install-providers.js"
    },
    "./contracts/tui-agent": {
      "types": "./dist/contracts/tui-agent.d.ts",
      "default": "./dist/contracts/tui-agent.js"
    },
    "./contracts/skill-vault-contract": {
      "types": "./dist/contracts/skill-vault-contract.d.ts",
      "default": "./dist/contracts/skill-vault-contract.js"
    },
    "./contracts/skill-pack-contract": {
      "types": "./dist/contracts/skill-pack-contract.d.ts",
      "default": "./dist/contracts/skill-pack-contract.js"
    },
    "./contracts/skill-metadata": {
      "types": "./dist/contracts/skill-metadata.d.ts",
      "default": "./dist/contracts/skill-metadata.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
