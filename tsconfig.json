{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node18",
    "moduleResolution": "Node16",
    "strict": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test-fixture.ts"]
}
