{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "skills-manager",
  "name": "Skills Manager",
  "version": "0.2.5",
  "description": "Unified Skills Vault, Packs, Marketplace & Read-Only Plugin Skills workbench across all PMStudio agents.",
  "cover": {
    "path": "images/cover.png",
    "alt": "Skills Manager 技能工作台：已安装技能列表、在线市场与技能包审计"
  },
  "execution": "trusted-worker",
  "main": "dist/plugin-worker.mjs",
  "engines": {
    "orca": ">=1.4.274"
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "settings:own" },
    { "kind": "storage:own" }
  ],
  "contributes": {
    "events": [
      { "on": "workspace.changed" }
    ],
    "pages": [
      {
        "id": "skills-workbench",
        "title": "Skills Manager",
        "icon": "layers",
        "entry": "ui/skills-page.html",
        "ui": "html",
        "sidebar": {
          "placement": "primary",
          "order": 100
        },
        "layout": "full-page"
      }
    ],
    "panels": [
      {
        "id": "skills-quick-toggle",
        "title": "Skills Quick Toggle",
        "icon": "layers",
        "entry": "ui/skills-panel.html",
        "ui": "html"
      }
    ]
  }
}
